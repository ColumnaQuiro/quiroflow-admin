# A fresh (lockfile-less) `npm install` of Nuxt's peer tree hits a real npm
# Arborist bug (`Cannot read properties of null (reading 'edgesOut')`) in
# `#loadPeerSet` during ideal-tree building -- reproduced consistently on
# npm 10.9.7. legacy-peer-deps sidesteps it; once package-lock.json exists,
# `npm ci` doesn't rebuild the ideal tree from scratch so wouldn't hit this
# regardless, but this keeps a plain `npm install` working too.
legacy-peer-deps=true
