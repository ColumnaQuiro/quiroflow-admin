# Same Supabase project as the main quiroflow app -- this panel reads its
# data (accounts/subscriptions/plans), it doesn't have its own database.
NUXT_PUBLIC_SUPABASE_URL=
NUXT_PUBLIC_SUPABASE_KEY=

# Service role key (Project Settings -> API -> service_role secret). Used
# server-side only, after ADMIN_ALLOWED_EMAILS has confirmed the caller --
# never sent to the browser.
NUXT_SUPABASE_SECRET_KEY=

# Comma-separated list of email addresses allowed to use this panel (e.g.
# your own Supabase Auth login email). Anyone else who signs in against the
# same Supabase project just gets 403s from every API route -- this is the
# actual access control, not the login screen itself.
NUXT_ADMIN_ALLOWED_EMAILS=

# Same Stripe account as the main quiroflow repo's
# NUXT_STRIPE_PLATFORM_BILLING_SECRET_KEY (Dashboard -> Developers -> API
# keys -> secret key, sk_...). Used here to create Checkout Sessions when you
# click "Start subscription" on an account -- the main app's webhook is what
# then syncs the resulting subscription back into the database, so both
# repos must point at the same account or nothing will sync.
NUXT_STRIPE_PLATFORM_BILLING_SECRET_KEY=

# Where a customer lands after completing (or backing out of) a Checkout
# Session started from this panel. Defaults to the production app if unset.
NUXT_PUBLIC_MAIN_APP_URL=
